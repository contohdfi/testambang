<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Input Transaksi - Tambang Jogosari</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-light">

<div class="d-flex">
    <!-- Sidebar Dummy -->
    <div class="bg-dark text-white p-3 vh-100 d-none d-md-block" style="width: 250px;">
        <h4>Jogosari</h4>
        <hr>
        <ul class="nav flex-column">
            <li class="nav-item"><a href="dashboard.html" class="nav-link text-white">Dashboard</a></li>
            <li class="nav-item"><a href="transaksi.html" class="nav-link text-warning fw-bold">Input Transaksi</a></li>
            <li class="nav-item"><a href="#" onclick="logout()" class="nav-link text-danger">Logout</a></li>
        </ul>
    </div>

    <!-- Konten Utama -->
    <div class="container-fluid p-4">
        <h2 class="mb-4">Input Transaksi Baru</h2>
        
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form id="formTransaksi">
                    <!-- Pemilihan Jenis Transaksi -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Jenis Transaksi</label>
                        <select class="form-select form-select-lg" id="jenis" name="jenis" required onchange="toggleForm()">
                            <option value="">-- Pilih Jenis --</option>
                            <option value="Pemasukan">Pemasukan</option>
                            <option value="Pengeluaran">Pengeluaran</option>
                        </select>
                    </div>

                    <!-- Pilihan Subjenis (Hanya Pemasukan) -->
                    <div class="mb-3 d-none" id="divSubjenis">
                        <label class="form-label fw-bold">Kategori Pemasukan</label>
                        <select class="form-select" id="subjenis" name="subjenis" onchange="toggleForm()">
                            <option value="Truk Bayar">Pemasukan Truk Bayar</option>
                            <option value="Pemasukan Biasa">Pemasukan Lainnya / Biasa</option>
                        </select>
                    </div>

                    <!-- FORM TRUK BAYAR -->
                    <div id="formTruk" class="d-none bg-info bg-opacity-10 p-3 rounded mb-3 border border-info">
                        <h5 class="text-info-emphasis">Data Truk & Material</h5>
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label>Nopol Kendaraan</label>
                                <input type="text" class="form-control text-uppercase" id="nopol" name="nopol">
                            </div>
                            <div class="col-md-6 mb-2">
                                <label>Nama Sopir</label>
                                <input type="text" class="form-control" id="sopir" name="sopir">
                            </div>
                            <div class="col-md-6 mb-2">
                                <label>Material</label>
                                <select class="form-select" id="material" name="material">
                                    <option value="Pasir">Pasir</option>
                                    <option value="Sirtu">Sirtu</option>
                                    <option value="Tanah">Tanah</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-2">
                                <label>Metode Pembayaran</label>
                                <select class="form-select" id="pembayaran" name="pembayaran">
                                    <option value="Cash">Cash</option>
                                    <option value="Transfer">Transfer</option>
                                    <option value="Bon">Bon (Hutang)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- FORM UMUM (Rincian & Nominal) -->
                    <div id="formUmum" class="d-none">
                        <div class="mb-3">
                            <label class="form-label">Rincian / Tujuan Transaksi</label>
                            <input type="text" class="form-control" id="rincian" name="rincian">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-success">Nominal (Rp)</label>
                            <input type="number" class="form-control form-control-lg" id="nominal" name="nominal" required>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label>Penanggung Jawab (PJ)</label>
                                <input type="text" class="form-control" id="pj" name="pj">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label>Keterangan Tambahan</label>
                                <input type="text" class="form-control" id="keterangan" name="keterangan">
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 mt-3" id="btnSubmit" disabled>Simpan Transaksi</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="js/api.js"></script>
<script src="js/transaksi.js"></script>
</body>
</html>
